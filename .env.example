# =============================================================================
# ILAW Lesson Plan Generator — Environment Variables
# =============================================================================
# 1. Copy this file to a new file named ".env.local"
# 2. Paste your Anthropic (Claude) API key after the "=" sign below.
# 3. NEVER share this key or commit .env.local to GitHub. It is like a password.
#
# Where to get the key:
#   - Go to https://console.anthropic.com/
#   - Sign in, then open "API Keys" and click "Create Key".
#   - Copy the key (it starts with "sk-ant-...") and paste it below.
# =============================================================================

ANTHROPIC_API_KEY=sk-ant-your-key-goes-here

# Optional: change the Claude model. Leave as-is if unsure.
# Good options (as of mid-2026): claude-sonnet-4-6 (balanced, recommended),
# claude-opus-4-8 (highest quality, pricier), claude-haiku-4-5 (fastest, cheapest).
CLAUDE_MODEL=claude-sonnet-4-6
