# =============================================================================
# ILAW Lesson Plan Generator — Environment Variables
# =============================================================================
# 1. Copy this file to a new file named ".env.local"
# 2. Paste your Google Gemini API key after the "=" sign below.
# 3. NEVER share this key or commit .env.local to GitHub. It is like a password.
#
# Where to get the key (it's FREE, no credit card needed):
#   - Go to https://aistudio.google.com/apikey
#   - Sign in with a Google account and click "Create API key".
#   - Copy the key and paste it below.
# =============================================================================

GEMINI_API_KEY=your-key-goes-here

# Optional: change the Gemini model. Leave as-is if unsure.
# Free-tier options (mid-2026): gemini-2.5-flash (recommended, fast + free),
# gemini-2.5-flash-lite (even cheaper/faster). "flash" models are best for the free tier.
GEMINI_MODEL=gemini-2.5-flash
